# Supabase (the database). Set these in Vercel (Production and Preview) and in a local, gitignored .env.local. Never in the browser.
SUPABASE_URL=
# The project's secret / service-role key. Server only.
SUPABASE_SECRET_KEY=
# Leave unset: the app uses the "public" schema. (Only the old combined project used "preview".)
SUPABASE_DB_SCHEMA=

# Accounts (sign-in). Browser-safe values, so they are not secrets. Leave them out and the app runs without accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Length of the emailed code. Supabase sends 8 digits unless you change it in Authentication > Email.
NEXT_PUBLIC_OTP_LENGTH=8

# Music planner
ANTHROPIC_API_KEY=

# Optional. If set, the music planner API requires this passcode (the planner screen asks for it once).
# Recommended: the planner spends Anthropic credit and the app has no accounts.
PLANNER_PASSCODE=
