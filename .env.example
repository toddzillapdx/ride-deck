# Supabase (the database). Set these in Vercel (Production and Preview) and in a local, gitignored .env.local. Never in the browser.
SUPABASE_URL=
# The project's secret / service-role key. Server only.
SUPABASE_SECRET_KEY=
# Leave unset in production (uses the "public" schema). Set to "preview" for Vercel Preview deploys and local testing.
SUPABASE_DB_SCHEMA=

# Music planner
ANTHROPIC_API_KEY=

# Optional. If set, the music planner API requires this passcode (the planner screen asks for it once).
# Recommended: the planner spends Anthropic credit and the app has no accounts.
PLANNER_PASSCODE=

# Only while running scripts/import-airtable.ts locally (read-only). Remove after the migration.
# AIRTABLE_TOKEN=
# AIRTABLE_BASE_ID=
